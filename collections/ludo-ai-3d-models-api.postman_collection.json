      },
      "item": [
        {
          "id": "a8c56ecb-b5eb-48c3-8db6-e6c09605738f",
          "name": "Ludo.ai Convert a 2D image to a 3D model",
          "request": {
            "name": "Ludo.ai Convert a 2D image to a 3D model",
            "description": {
              "content": "Convert a 2D image into a textured 3D GLB model with configurable PBR textures, polygon count, and texture resolution. Processing takes 60 to 120 seconds. Returns the GLB model URL and four snapshot images from different angles. Costs 3 credits per model.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "3d-models",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"<string>\",\n  \"texture_type\": \"pbr\",\n  \"texture_size\": 2048,\n  \"target_num_faces\": 50000,\n  \"high_detail_shape\": \"<boolean>\",\n  \"request_id\": \"<string>\"\n}",
              "options": {
                "raw": {
