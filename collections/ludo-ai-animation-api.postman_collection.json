        {
          "name": "animate",
          "item": [
            {
              "name": "Ludo.ai Create animated spritesheets from static images",
              "id": "15a27ad2-29d0-4f9b-b6ac-df574c53647d",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"initial_image\": \"<string>\",\n  \"motion_prompt\": \"<string>\",\n  \"image_type\": \"sprite-vfx\",\n  \"frames\": 36,\n  \"frame_size\": 256,\n  \"loop\": true,\n  \"model\": \"standard\",\n  \"duration\": \"<number>\",\n  \"final_image\": \"<string>\",\n  \"gif\": false,\n  \"individual_frames\": false,\n  \"spritesheet_with_background\": false,\n  \"request_id\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/sprites/animate",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "sprites",
                    "animate"
                  ]
                },
                "description": "Transform a static sprite image into an animated spritesheet by describing the desired motion. Supports configurable frame counts from 4 to 64, frame sizes, seamless looping, and optional GIF output. Processing takes 30 to 90 seconds. Costs 5 credits per animation."
              },
              "response": [
                {
                  "id": "3a4ae65b-878f-4a93-a9f9-efc0e81d9973",
                  "name": "Successfully created animation",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
