          "name": "transfer-motion",
          "item": [
            {
              "name": "Ludo.ai Transfer motion onto a static sprite",
              "id": "6b44e89d-fb65-4fc4-99eb-41876fbd2a88",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"image\": \"<string>\",\n  \"video\": \"<string>\",\n  \"preset_id\": \"<string>\",\n  \"direction\": \"S\",\n  \"perspective\": \"<string>\",\n  \"frames\": \"<integer>\",\n  \"frame_size\": \"<integer>\",\n  \"loop\": \"<boolean>\",\n  \"crop\": \"<boolean>\",\n  \"margin_ratio\": \"<number>\",\n  \"margin_ratio_mode\": \"manual\",\n  \"gif\": false,\n  \"individual_frames\": false,\n  \"spritesheet_with_background\": false,\n  \"request_id\": \"<string>\"\n}",
                  "options": {
