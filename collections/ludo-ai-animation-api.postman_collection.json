      },
      "item": [
        {
          "id": "bce0b2c7-2e4a-4fc0-aa1d-4d68409cd148",
          "name": "Ludo.ai Create animated spritesheets from static images",
          "request": {
            "name": "Ludo.ai Create animated spritesheets from static images",
            "description": {
              "content": "Transform a static sprite image into an animated spritesheet by describing the desired motion. Supports configurable frame counts from 4 to 64, frame sizes, seamless looping, and optional GIF output. Processing takes 30 to 90 seconds. Costs 5 credits per animation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sprites",
                "animate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initial_image\": \"<string>\",\n  \"motion_prompt\": \"<string>\",\n  \"image_type\": \"<string>\",\n  \"frames\": 36,\n  \"frame_size\": 256,\n  \"loop\": true,\n  \"model\": \"standard\",\n  \"duration\": \"<number>\",\n  \"final_image\": \"<string>\",\n  \"gif\": false,\n  \"individual_frames\": false,\n  \"spritesheet_with_background\": false,\n  \"request_id\": \"<string>\"\n}",
